FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     pimpleFoam;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         0.25;

deltaT          1.7e-05;

writeControl    adjustableRunTime;

writeInterval   0.02;

purgeWrite      2;

adjustTimeStep  yes;

maxCo           20;

maxDeltaT       1.7e-05;

writeFormat     ascii;

writePrecision  7;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable false;

functions
{
    forceCoeffs
    {
        type            forceCoeffs;
        libs            (forces);
        patches         (airfoil);
        rho             rhoInf;
        rhoInf          1.0;
        liftDir         (-0.20791169 0.97814760 0);
        dragDir         (0.97814760 0.20791169 0);
        CofR            (0.25 0 0);
        pitchAxis       (0 0 1);
        magUInf         5.400000;
        lRef            1.0;
        Aref            0.100000;
        writeControl    adjustableRunTime;
        writeInterval   0.005;
        log             yes;
    }

    wallShearStress
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        patches         (airfoil);
        writeControl    writeTime;
    }

    surfaces
    {
        type            surfaces;
        libs            (sampling);
        writeControl    writeTime;
        surfaceFormat   raw;
        fields          (p U wallShearStress);
        surfaces
        (
            airfoil
            {
                type            patch;
                patches         (airfoil);
                interpolate     true;
            }
        );
    }

    residuals
    {
        type            residuals;
        libs            (utilityFunctionObjects);
        fields          (p U k omega);
    }
}

