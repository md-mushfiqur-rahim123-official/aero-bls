FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1.00623059e-05;

boundaryField
{
    airfoil
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }
    farfield
    {
        type            freestream;
        freestreamValue uniform 1.00623059e-05;
    }
    front
    {
        type            empty;
    }
    back
    {
        type            empty;
    }
}

