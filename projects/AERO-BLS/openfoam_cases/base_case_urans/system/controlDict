FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     pimpleFoam;

startFrom       startTime;

startTime       0;

stopAt          endTime;

endTime         __ENDTIME__;

deltaT          1e-04;

writeControl    adjustableRunTime;

writeInterval   1;

purgeWrite      2;

adjustTimeStep  yes;

maxCo           10;

maxDeltaT       5e-03;

writeFormat     ascii;

writePrecision  7;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable false;

functions
{
    forceCoeffs
    {
        type            forceCoeffs;
        libs            (forces);
        patches         (airfoil);
        rho             rhoInf;
        rhoInf          1.0;
        liftDir         (__LIFTX__ __LIFTY__ 0);
        dragDir         (__DRAGX__ __DRAGY__ 0);
        CofR            (0.25 0 0);
        pitchAxis       (0 0 1);
        magUInf         __MAGUINF__;
        lRef            1.0;
        Aref            __AREF__;
        writeControl    adjustableRunTime;
        writeInterval   0.005;
        log             yes;
    }

    wallShearStress
    {
        type            wallShearStress;
        libs            (fieldFunctionObjects);
        patches         (airfoil);
        writeControl    writeTime;
    }

    surfaces
    {
        type            surfaces;
        libs            (sampling);
        writeControl    writeTime;
        surfaceFormat   raw;
        fields          (p U wallShearStress);
        surfaces
        (
            airfoil
            {
                type            patch;
                patches         (airfoil);
                interpolate     true;
            }
        );
    }

    residuals
    {
        type            residuals;
        libs            (utilityFunctionObjects);
        fields          (p U k omega);
    }
}

